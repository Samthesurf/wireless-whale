<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- forceDarkAllowed belongs on the theme, not on the application tag.
         Light bars keep dark glyphs on the white app surface. -->
    <style name="Theme.WirelessWhale" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
